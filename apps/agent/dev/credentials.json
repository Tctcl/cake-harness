{
  "schemaVersion": 1,
  "credentials": [
    {
      "id": "github",
      "env": {
        "GH_TOKEN": "ghp_dummy_not_a_real_token",
        "GITHUB_TOKEN": "ghp_dummy_not_a_real_token"
      },
      "files": [
        {
          "path": "~/.config/gh/hosts.yml",
          "mode": "0600",
          "content": "github.com:\n    oauth_token: ghp_dummy_not_a_real_token\n    user: dummy\n    git_protocol: https\n"
        },
        {
          "path": "~/.gitconfig-gh",
          "mode": "0600",
          "content": "[credential \"https://github.com\"]\n\thelper = !gh auth git-credential\n"
        }
      ]
    },
    {
      "id": "npm",
      "env": {},
      "files": [
        {
          "path": "~/.npmrc",
          "mode": "0600",
          "content": "//registry.npmjs.org/:_authToken=npm_dummy_not_a_real_token\n"
        }
      ]
    }
  ]
}
