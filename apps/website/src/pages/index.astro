---
import '../styles/landing.css'

const repository = 'https://github.com/Tctcl/cake-harness'
const releases = `${repository}/releases`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Cake is a self-hosted agent harness built on Pi, with a web interface, isolated workspaces, and agent profiles."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://tctcl.de/" />
    <title>Cake — Pi, but stuffed.</title>
    <script is:inline>
      (() => {
        const stored = typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme')
        const theme = stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
        document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark'
      })()
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href="/" aria-label="Cake home">
          <svg class="cake-mark" viewBox="0 0 48 48" fill="none" aria-hidden="true">
            <path d="M8 21.5 38 12v25H8v-15.5Z" fill="currentColor" />
            <path class="mark-cream" d="m8 21.5 30-9.5v7L8 29v-7.5Z" />
            <path class="mark-layer" d="M8 29h30v8H8z" />
            <path d="M8 21.5 38 12v25H8v-15.5Z" stroke="var(--ink)" stroke-width="2.2" stroke-linejoin="round" />
            <path d="M24 16V9" stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round" />
            <path class="mark-flame" d="M24 3c3 3 3 5 0 7-3-2-3-4 0-7Z" />
          </svg>
          <span>Cake</span>
        </a>
        <nav class="main-nav" aria-label="Main navigation">
          <a href="/docs">Docs</a>
          <a href={repository} rel="external">GitHub</a>
          <a class="nav-changelog" href={releases} rel="external">Changelog</a>
          <button id="theme-toggle" class="icon-button" type="button" aria-label="Switch color theme">
            <svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41" />
            </svg>
            <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero shell">
        <div class="eyebrow"><span class="status-dot"></span> Self-hosted. Yours end to end.</div>
        <h1>Pi, but <span>stuffed.</span></h1>
        <p class="hero-pitch">
          Cake is an agent harness built on top of Pi. It adds a web interface, workspaces with isolated
          Docker containers, and agent profiles — Pi only has one — so you can create your own plan mode.
        </p>
        <p class="pi-credit">
          Built on <a href="https://pi.dev" rel="external">Pi</a>, the minimal coding-agent harness by Earendil.
          More filling, same good base.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/docs">Read the docs <span aria-hidden="true">→</span></a>
          <a class="button button-secondary" href={repository} rel="external">View on GitHub</a>
        </div>

        <div class="install-wrap">
          <div class="install-heading">
            <span>Install on your server</span>
            <span class="install-channel">production</span>
          </div>
          <div class="install-command-row">
            <code id="install-command">curl -fsSL https://github.com/Tctcl/cake-harness/releases/latest/download/install.sh | sudo bash -s -- --domain cake.example.com</code>
            <button id="copy-install" class="copy-button" type="button" aria-label="Copy install command">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="8" y="8" width="12" height="12" rx="2" />
                <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
              </svg>
              <span>Copy</span>
            </button>
          </div>
          <p>Requires a Linux server with Docker and a domain. Replace <code>cake.example.com</code> with yours.</p>
        </div>
      </section>

      <section class="why shell" aria-labelledby="why-title">
        <div class="section-heading">
          <p class="kicker">Why Cake?</p>
          <h2 id="why-title">The harness, with room to work.</h2>
          <p>Pi keeps the core small. Cake adds the pieces around a real, everyday agent workflow.</p>
        </div>
        <div class="feature-grid">
          <article class="feature-card">
            <span class="feature-number">01</span>
            <h3>A web interface</h3>
            <p>Chat, inspect runs, configure agents, and open a terminal from a browser — on your desk or your phone.</p>
          </article>
          <article class="feature-card">
            <span class="feature-number">02</span>
            <h3>Isolated workspaces</h3>
            <p>Each workspace gets its own Docker container. File and shell tools run there through a pi-env daemon.</p>
          </article>
          <article class="feature-card">
            <span class="feature-number">03</span>
            <h3>Profiles, plural</h3>
            <p>Give each agent a model, prompt, instructions, key, thinking level, and tool grants. Build your own plan mode.</p>
          </article>
          <article class="feature-card">
            <span class="feature-number">04</span>
            <h3>Quick model switches</h3>
            <p>Change the model, thinking level, or provider key for one conversation without rebuilding its agent.</p>
          </article>
          <article class="feature-card">
            <span class="feature-number">05</span>
            <h3>The whole turn</h3>
            <p>See streamed thinking, tool calls as they happen, and compaction lines. The useful parts are not hidden.</p>
          </article>
          <article class="feature-card">
            <span class="feature-number">06</span>
            <h3>Durable by default</h3>
            <p>Conversations live in Postgres with pi-durable. Reload the page or restart the service; the session remains.</p>
          </article>
        </div>
      </section>

      <section class="pillar shell" aria-labelledby="workspaces-title">
        <div class="pillar-copy">
          <p class="kicker">Workspaces &amp; containers</p>
          <h2 id="workspaces-title">A place for the work to happen.</h2>
          <p>
            A workspace brings its files, provider access, agents, and tool ceiling together. Its container is where
            <code>read</code>, <code>write</code>, <code>edit</code>, and <code>bash</code> do their work.
          </p>
          <ul class="check-list">
            <li>No container ports need to be opened for agent tools.</li>
            <li>A browser terminal attaches directly to the workspace container.</li>
            <li>General stays container-free and gets only the environment-free <code>web_fetch</code> tool.</li>
          </ul>
          <a class="text-link" href="/docs/workspaces">Explore workspaces <span aria-hidden="true">→</span></a>
        </div>
        <div class="mockup workspace-mock" aria-label="Illustration of a workspace terminal">
          <div class="mock-topbar">
            <div class="window-dots"><i></i><i></i><i></i></div>
            <span>Product / Terminal</span>
            <span class="live-badge">running</span>
          </div>
          <div class="workspace-labels">
            <span>Workspace <strong>Product</strong></span>
            <span>Container <strong>isolated</strong></span>
          </div>
          <div class="terminal-body">
            <p><span class="prompt">agent</span> read <span class="muted">src/routes.ts</span></p>
            <p class="tool-result">Read 184 lines</p>
            <p><span class="prompt">agent</span> edit <span class="muted">src/routes.ts</span></p>
            <p class="tool-result">Updated 3 lines</p>
            <p><span class="prompt">agent</span> bash <span class="muted">pnpm test</span></p>
            <p class="test-pass">✓ 12 tests passed</p>
            <p class="terminal-cursor"><span>›</span><i></i></p>
          </div>
          <div class="mock-caption"><span class="status-dot"></span> Tools execute through pi-env inside this container</div>
        </div>
      </section>

      <section class="pillar pillar-reverse shell" aria-labelledby="profiles-title">
        <div class="pillar-copy">
          <p class="kicker">Agent profiles</p>
          <h2 id="profiles-title">Your plan mode. Your rules.</h2>
          <p>
            Profiles turn one harness into a small team of specialists. A Plan agent can have a planning prompt and
            only <code>read</code> + <code>web_fetch</code>, while another profile can edit and test.
          </p>
          <p>Workspace grants set the ceiling. Each agent gets only the capabilities it needs inside that ceiling.</p>
          <a class="text-link" href="/docs/agents#example-a-plan-agent">Build a Plan agent <span aria-hidden="true">→</span></a>
        </div>
        <div class="mockup profiles-mock" aria-label="Illustration of agent profile settings">
          <div class="mock-topbar">
            <span>Workspace / Agents</span>
            <span class="small-pill">2 profiles</span>
          </div>
          <div class="profile-layout">
            <div class="profile-list">
              <div><span class="profile-avatar">A</span><strong>Assistant</strong><small>Build &amp; test</small></div>
              <div class="selected"><span class="profile-avatar">P</span><strong>Plan</strong><small>Read &amp; reason</small></div>
            </div>
            <div class="profile-form">
              <div class="profile-title"><span class="profile-avatar">P</span><div><strong>Plan</strong><small>Think first, change nothing.</small></div></div>
              <label>System prompt</label>
              <div class="prompt-box">Inspect the codebase, ask the useful questions, then produce an ordered implementation plan. Do not modify files.</div>
              <label>Tool grants</label>
              <div class="grant-row"><span>read</span><span>web_fetch</span><span class="grant-off">write</span><span class="grant-off">bash</span></div>
              <div class="profile-settings"><span>Thinking <strong>high</strong></span><span>Reach every capability <strong>off</strong></span></div>
            </div>
          </div>
        </div>
      </section>

      <section class="pillar shell" aria-labelledby="chat-title">
        <div class="pillar-copy">
          <p class="kicker">The chat shows everything</p>
          <h2 id="chat-title">No mystery between prompt and answer.</h2>
          <p>
            Follow the turn while it streams: the model’s thinking, each tool call and its result, and the points where
            context is compacted. Switch model, thinking level, or key right in the conversation.
          </p>
          <p>The transcript is durable, so stepping away does not throw the session away.</p>
          <a class="text-link" href="/docs/chat">See the conversation controls <span aria-hidden="true">→</span></a>
        </div>
        <div class="mockup chat-mock" aria-label="Illustration of a streaming Cake conversation">
          <div class="mock-topbar">
            <span>Plan the authentication fix</span>
            <span class="model-pill">high thinking⌄</span>
          </div>
          <div class="chat-body">
            <div class="user-message">Find why sessions disappear, but don’t edit anything yet.</div>
            <details class="thinking-block" open>
              <summary><span class="tiny-spinner"></span> Thinking through the session flow</summary>
              <p>I’ll trace cookie creation first, then compare the proxy configuration.</p>
            </details>
            <div class="chat-tool"><span class="tool-icon">↳</span><div><strong>read</strong><code>src/auth/session.ts</code></div><span>✓</span></div>
            <div class="chat-tool"><span class="tool-icon">↳</span><div><strong>bash</strong><code>rg "secure" src</code></div><span class="tool-running">running</span></div>
            <div class="compaction"><span></span> Context compacted · conversation continues <span></span></div>
            <p class="assistant-message">The cookie is marked Secure only when forwarded protocol is trusted. I found the relevant branch…<i></i></p>
          </div>
        </div>
      </section>

      <section class="pillar pillar-reverse shell" aria-labelledby="self-hosted-title">
        <div class="pillar-copy">
          <p class="kicker">Self-hosted &amp; secure</p>
          <h2 id="self-hosted-title">Your server is not an afterthought.</h2>
          <p>
            One installer assembles a Docker Compose stack behind Traefik with Let’s Encrypt. Password sign-in and
            optional TOTP protect the interface; provider keys are stored encrypted.
          </p>
          <p>Single-user by default. No vendor control plane, no separate hosted account.</p>
          <a class="text-link" href="/docs/architecture">Read the architecture <span aria-hidden="true">→</span></a>
        </div>
        <div class="mockup server-mock" aria-label="Illustration of Cake's self-hosted stack">
          <div class="server-status"><span class="status-dot"></span><strong>cake.example.com</strong><span>HTTPS</span></div>
          <div class="stack-flow">
            <div class="stack-node"><small>edge</small><strong>Traefik</strong><span>Let’s Encrypt</span></div>
            <div class="stack-connector">→</div>
            <div class="stack-node accent-node"><small>app</small><strong>Cake</strong><span>Web + API</span></div>
            <div class="stack-connector">→</div>
            <div class="stack-node"><small>state</small><strong>Postgres</strong><span>Durable chat</span></div>
          </div>
          <div class="security-grid">
            <div><span>✓</span><strong>Password + TOTP</strong><small>Optional second factor</small></div>
            <div><span>✓</span><strong>Encrypted keys</strong><small>Provider credentials sealed</small></div>
            <div><span>✓</span><strong>Private networks</strong><small>Database and secrets isolated</small></div>
            <div><span>✓</span><strong>One host</strong><small>Code and state you can inspect</small></div>
          </div>
        </div>
      </section>

      <section class="not-built shell" aria-labelledby="not-built-title">
        <div>
          <p class="kicker">What we didn’t build (yet)</p>
          <h2 id="not-built-title">A smaller list beats a bigger claim.</h2>
        </div>
        <div class="not-built-list">
          <div><span>Not a SaaS</span><p>No multi-tenant cloud and no multi-user mode. One Cake install is for one owner.</p></div>
          <div><span>Planned</span><p>MCP servers and skills/prompt grants reaching runs are not wired up yet.</p></div>
          <div><span>Planned</span><p>Web search is not built in. <code>web_fetch</code> can retrieve public pages, not search the web.</p></div>
        </div>
      </section>

      <section class="final-cta shell">
        <div class="final-cta-inner">
          <svg class="cta-mark" viewBox="0 0 48 48" fill="none" aria-hidden="true">
            <path d="M8 21.5 38 12v25H8v-15.5Z" fill="currentColor" />
            <path d="m8 21.5 30-9.5v7L8 29v-7.5Z" fill="#FFF1D9" />
            <path d="M8 21.5 38 12v25H8v-15.5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
            <path d="M24 16V9" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            <path d="M24 3c3 3 3 5 0 7-3-2-3-4 0-7Z" fill="#F6B73C" />
          </svg>
          <p class="kicker">Have your cake. Run it too.</p>
          <h2>Put an agent to work on your own server.</h2>
          <div class="hero-actions">
            <a class="button button-light" href="/docs/install">Install Cake <span aria-hidden="true">→</span></a>
            <a class="button button-on-accent" href={releases} rel="external">See releases</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-inner shell">
        <div>
          <a class="wordmark footer-wordmark" href="/">Cake</a>
          <p>Cake is built on <a href="https://pi.dev" rel="external">Pi by Earendil</a>.</p>
        </div>
        <div class="footer-links">
          <a href={repository} rel="external">GitHub</a>
          <a href={`${repository}/blob/main/LICENSE`} rel="external">MIT License</a>
          <a href="/docs">Documentation</a>
          <span>© tctcl</span>
        </div>
      </div>
    </footer>

    <script>
      const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle')

      const updateThemeLabel = () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
        themeToggle?.setAttribute('aria-label', `Switch to ${next} mode`)
        themeToggle?.setAttribute('title', `Switch to ${next} mode`)
      }

      updateThemeLabel()
      themeToggle?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
        document.documentElement.dataset.theme = theme
        localStorage.setItem('starlight-theme', theme)
        updateThemeLabel()
      })

      const copyButton = document.querySelector<HTMLButtonElement>('#copy-install')
      const command = document.querySelector<HTMLElement>('#install-command')
      let copyTimer: number | undefined

      copyButton?.addEventListener('click', async () => {
        if (!command?.textContent) return
        const label = copyButton.querySelector('span')
        try {
          await navigator.clipboard.writeText(command.textContent.trim())
          if (label) label.textContent = 'Copied'
        } catch {
          if (label) label.textContent = 'Select & copy'
          const selection = window.getSelection()
          const range = document.createRange()
          range.selectNodeContents(command)
          selection?.removeAllRanges()
          selection?.addRange(range)
        }
        window.clearTimeout(copyTimer)
        copyTimer = window.setTimeout(() => {
          if (label) label.textContent = 'Copy'
        }, 2000)
      })
    </script>
  </body>
</html>
