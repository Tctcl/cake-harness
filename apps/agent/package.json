    "@cake-harness/oxlint-config": "workspace:*",
    "@cake-harness/typescript-config": "workspace:*",
    "@cake-harness/vitest-config": "workspace:*",
    "@types/node": "^26.6.6",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
