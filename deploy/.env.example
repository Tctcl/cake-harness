# Written to /var/lib/tctcl-platform/.env by install.sh, which never overwrites
# an existing file: the secrets in it are the deployment.
#
# This example is the shape, not a source of values. Do not copy it into place.

# Absolute paths, so the compose file works from any directory.
INSTALL_DIR=/opt/tctcl-platform
STATE_DIR=/var/lib/tctcl-platform

# Domain Traefik serves this instance on, and the address Let's Encrypt
# registers. Port 80 and 443 must reach this host.
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# Generated once per install with `openssl rand -hex 32`.
POSTGRES_DB=tctcl
POSTGRES_USER=tctcl
POSTGRES_PASSWORD=

# What this install follows: `production` pins a release, `staging` tracks the moving `staging` tag that every push
# to main overwrites. install.sh rewrites these four lines on every run, so an existing install never keeps a stale image.
TCTCL_CHANNEL=production
TCTCL_VERSION=0.0.1
TCTCL_IMAGE=ghcr.io/tctcl/tlabs-platform:0.0.1
TCTCL_WORKSPACE_IMAGE=ghcr.io/tctcl/tlabs-platform/workspace:0.0.1
