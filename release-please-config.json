{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "package-name": "tctcl-platform",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "initial-version": "0.0.1",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Refactors" },
    { "type": "docs", "section": "Documentation" },
    { "type": "revert", "section": "Reverts" },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true }
  ],
  "packages": {
    ".": {
      "release-type": "node",
      "extra-files": [
        { "type": "json", "path": "apps/agent/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/backend/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/frontend/package.json", "jsonpath": "$.version" },
        {
          "type": "json",
          "path": "packages/oxlint-config/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/typescript-config/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/vitest-config/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
