# Written to /var/lib/cake-harness/.env by install.sh, which never overwrites
# an existing file: the secrets in it are the deployment.
#
# This example is the shape, not a source of values. Do not copy it into place.

# Absolute paths, so the compose file works from any directory.
INSTALL_DIR=/opt/cake-harness
STATE_DIR=/var/lib/cake-harness

# Domain Traefik serves this instance on, and the address Let's Encrypt
# registers. Port 80 and 443 must reach this host.
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# Generated once per install with `openssl rand -hex 32`.
POSTGRES_DB=cake
POSTGRES_USER=cake
POSTGRES_PASSWORD=

# What this install follows: `production` pins a release, `staging` tracks the moving `staging` tag that every push
# to main overwrites. install.sh rewrites these five lines on every run, so an existing install never keeps a stale image.
# CAKE_VERSION is empty on staging: a moving tag has no version to compare against.
CAKE_CHANNEL=production
CAKE_VERSION=0.0.1
CAKE_IMAGE=ghcr.io/tctcl/cake-harness:0.0.1
CAKE_WORKSPACE_IMAGE=ghcr.io/tctcl/cake-harness/workspace:0.0.1
CAKE_CIPHERGATE_IMAGE=ghcr.io/tctcl/cake-harness/ciphergate:0.0.1

# How often the backend asks GitHub whether a newer release exists. 0 turns the check off; the answer is what the
# update link at the foot of the sidebar is built from.
UPDATE_CHECK_INTERVAL_MS=900000

# The backend's reader key into the secrets store. install.sh creates the consumer on the first install and
# writes the key here. This is the one secret the stack cannot read out of the store, because it is what
# opens it; rotate with `docker compose exec ciphergate gateway consumer rotate-key cake-backend`.
CIPHERGATE_TOKEN=

# Seals the second-factor secrets and the stored provider keys. Generated once with `openssl rand -hex 32`; regenerating it
# makes every enrolled authenticator and stored key unreadable.
SECRET_KEY=
