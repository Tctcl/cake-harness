[Unit]
Description=Cake update requests
Documentation=file:/opt/cake-harness/install.sh

[Socket]
# The backend container mounts this directory and writes one line: UPDATE 1.2.3.
ListenStream=/run/cake/updater.sock
# root writes; the backend runs with the cake-updater gid and is the only other
# writer. Nothing else on the host can ask for an update.
SocketMode=0660
SocketUser=root
SocketGroup=cake-updater
DirectoryMode=0750
# systemd accepts each connection and hands it to one instance of the service
# below, so no listener process exists between updates.
Accept=yes

[Install]
WantedBy=sockets.target
